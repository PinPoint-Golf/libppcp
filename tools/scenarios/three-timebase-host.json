{
  "peer_id": "sim:multi-clock-host",
  "role": "host",
  "protocol_version": "1.0",
  "profiles": ["core", "capture", "detect", "arbitrate", "live", "offline"],
  "product": { "vendor": "ppcp-sim", "model": "multi-clock-host", "version": "1" },
  "timebases": [
    { "id": "tb:host", "kind": "monotonic", "epoch_stable": true, "resolution_ns": 1000 },
    { "id": "tb:cam-a", "kind": "monotonic", "epoch_stable": true,
      "resolution_ns": 1000, "offset_ns": 61000000000, "skew_ppm": 6.0 },
    { "id": "tb:cam-b", "kind": "monotonic", "epoch_stable": true,
      "resolution_ns": 1000, "offset_ns": -23000000000, "skew_ppm": -9.0 }
  ],
  "sync_timebase": "tb:host",
  "sources": [
    {
      "id": "src:cam-a", "kind": "camera", "timebase": "tb:cam-a", "physical": true,
      "optics": "machine-vision", "label": "camera on its own clock",
      "profiles": [
        {
          "id": "cp:cam-a",
          "timing": { "convention": "start" },
          "geometry": { "kind": "global" },
          "intrinsics": "fixed",
          "format": { "codec": "raw", "width": 1920, "height": 1080, "pixel_format": "mono8" },
          "rate": { "nominal_mhz": 240000, "min_mhz": 30000, "max_mhz": 240000 },
          "optical": { "exposure_min_ns": 20000, "exposure_max_ns": 4000000,
                       "iso_min": 100, "iso_max": 1600 }
        }
      ]
    },
    {
      "id": "src:cam-b", "kind": "camera", "timebase": "tb:cam-b", "physical": true,
      "optics": "machine-vision", "label": "a second camera on a second clock",
      "profiles": [
        {
          "id": "cp:cam-b",
          "timing": { "convention": "start" },
          "geometry": { "kind": "global" },
          "intrinsics": "fixed",
          "format": { "codec": "raw", "width": 1280, "height": 1024, "pixel_format": "mono8" },
          "rate": { "nominal_mhz": 300000, "min_mhz": 30000, "max_mhz": 300000 },
          "optical": { "exposure_min_ns": 20000, "exposure_max_ns": 4000000,
                       "iso_min": 100, "iso_max": 1600 }
        }
      ]
    }
  ],
  "session": {
    "id": "ses:sim",
    "timebase_ref": "tb:host",
    "coincidence_window_ns": 50000000,
    "issue_hold_ns": 200000000,
    "heartbeat_interval_ms": 1000
  }
}
